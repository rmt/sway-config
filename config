# Minimal Sway config with floating-window placement zones.
# The Super/Windows key is Mod4; Alt is Mod1.
set $mod Mod4
set $term ghostty
set $zone_helper /home/rmt/.config/sway/zone_helper

font pango:monospace 10

# Deep-roast coffee palette: espresso browns, toasted cream, and brick-red accents.
set $mocha_base #1b1210
set $mocha_mantle #120b09
set $mocha_surface0 #2a1a16
set $mocha_surface1 #3d2520
set $mocha_overlay0 #79564b
set $mocha_text #e9d8c9
set $mocha_subtext0 #c5a897
set $mocha_copper #d18a5a
set $mocha_clay #b96f62
set $mocha_red #c65a4a

client.focused $mocha_copper $mocha_surface0 $mocha_text $mocha_copper $mocha_surface0
client.focused_inactive $mocha_surface1 $mocha_base $mocha_subtext0 $mocha_surface1 $mocha_base
client.unfocused $mocha_surface0 $mocha_mantle $mocha_subtext0 $mocha_surface0 $mocha_mantle
client.urgent $mocha_red $mocha_base $mocha_red $mocha_red $mocha_base
client.placeholder $mocha_surface0 $mocha_base $mocha_subtext0 $mocha_surface0 $mocha_base
client.background $mocha_base

# Open a terminal (Alt-X is the requested shortcut; Mod-Return is a handy extra).
bindsym Alt+x exec $term
bindsym $mod+x exec foot
bindsym $mod+Return exec $term
bindsym $mod+p exec bemenu-run

# Sway delegates screen locking to a locker; waylock is installed.
bindsym Ctrl+Alt+l exec waylock

# Exit the Sway session.
bindsym Ctrl+Alt+BackSpace exit

# Ask the focused application to close its window.
bindsym $mod+w kill

# Cycle through all windows on the current workspace.
bindsym $mod+Tab exec $zone_helper cycle-all next
bindsym $mod+Shift+Tab exec $zone_helper cycle-all previous

# Reload this file after editing. Sway does not automatically watch/reload it.
bindsym $mod+Shift+r reload

# Switch to numbered workspaces; Mod+0 targets workspace 10. Adding Shift moves
# the focused window there without switching the current workspace.
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
# Step through numbered workspaces 1-10 (creating missing ones); wrap at ends.
bindsym $mod+Left workspace prev
bindsym $mod+Right workspace next
bindsym $mod+Shift+Left exec $zone_helper move-step previous
bindsym $mod+Shift+Right exec $zone_helper move-step next

# Toggle floating for the focused window. Holding Mod and dragging with the
# left/right mouse buttons also moves/resizes windows (including tiled ones).
bindsym $mod+Shift+space floating toggle
floating_modifier $mod normal

# Float existing windows on startup/reload, and all newly opened windows.
exec_always swaymsg '[all] floating enable'
for_window [all] floating enable

# Zone placement and focus cycling. Unmarked windows default to the center
# zone; explicitly placed windows get per-window marks. Dimensions are workspace
# percentages; floating windows can overlap, and app size hints may prevent a
# window from being resized to the requested dimensions.
# Placement uses Shift+keypad; unshifted keypad keys cycle through that zone.

# Corner zones (keypad digit aliases support NumLock on/off).
bindsym $mod+Shift+KP_7 exec $zone_helper place tl
bindsym $mod+Shift+KP_Home exec $zone_helper place tl
bindsym $mod+Shift+KP_9 exec $zone_helper place tr
bindsym $mod+Shift+KP_Prior exec $zone_helper place tr
bindsym $mod+Shift+KP_1 exec $zone_helper place bl
bindsym $mod+Shift+KP_End exec $zone_helper place bl
bindsym $mod+Shift+KP_3 exec $zone_helper place br
bindsym $mod+Shift+KP_Next exec $zone_helper place br

# Half-screen zones.
bindsym $mod+Shift+KP_Left exec $zone_helper place left
bindsym $mod+Shift+KP_4 exec $zone_helper place left
bindsym $mod+Shift+KP_Right exec $zone_helper place right
bindsym $mod+Shift+KP_6 exec $zone_helper place right
bindsym $mod+Shift+KP_Up exec $zone_helper place top
bindsym $mod+Shift+KP_8 exec $zone_helper place top
bindsym $mod+Shift+KP_Down exec $zone_helper place bottom
bindsym $mod+Shift+KP_2 exec $zone_helper place bottom

# Center zone: KP_Begin is the NumLock-off alias for KP_5.
bindsym $mod+Shift+KP_5 exec $zone_helper place center
bindsym $mod+Shift+KP_Begin exec $zone_helper place center

# Larger placements: corners 70x70%; left/right 70x100%; top/bottom 100x70%.
bindsym $mod+Control+KP_7 exec $zone_helper place tl 70
bindsym $mod+Control+KP_Home exec $zone_helper place tl 70
bindsym $mod+Control+KP_9 exec $zone_helper place tr 70
bindsym $mod+Control+KP_Prior exec $zone_helper place tr 70
bindsym $mod+Control+KP_1 exec $zone_helper place bl 70
bindsym $mod+Control+KP_End exec $zone_helper place bl 70
bindsym $mod+Control+KP_3 exec $zone_helper place br 70
bindsym $mod+Control+KP_Next exec $zone_helper place br 70
bindsym $mod+Control+KP_Left exec $zone_helper place left 70
bindsym $mod+Control+KP_4 exec $zone_helper place left 70
bindsym $mod+Control+KP_Right exec $zone_helper place right 70
bindsym $mod+Control+KP_6 exec $zone_helper place right 70
bindsym $mod+Control+KP_Up exec $zone_helper place top 70
bindsym $mod+Control+KP_8 exec $zone_helper place top 70
bindsym $mod+Control+KP_Down exec $zone_helper place bottom 70
bindsym $mod+Control+KP_2 exec $zone_helper place bottom 70

# Extra-large center placement: 90% x 90%.
bindsym $mod+Control+KP_5 exec $zone_helper place center 90
bindsym $mod+Control+KP_Begin exec $zone_helper place center 90

# Cycle zones also include their contained corners (e.g. top includes tl/tr).
bindsym $mod+KP_7 exec $zone_helper cycle tl
bindsym $mod+KP_Home exec $zone_helper cycle tl
bindsym $mod+KP_9 exec $zone_helper cycle tr
bindsym $mod+KP_Prior exec $zone_helper cycle tr
bindsym $mod+KP_1 exec $zone_helper cycle bl
bindsym $mod+KP_End exec $zone_helper cycle bl
bindsym $mod+KP_3 exec $zone_helper cycle br
bindsym $mod+KP_Next exec $zone_helper cycle br
bindsym $mod+KP_Left exec $zone_helper cycle left
bindsym $mod+KP_4 exec $zone_helper cycle left
bindsym $mod+KP_Right exec $zone_helper cycle right
bindsym $mod+KP_6 exec $zone_helper cycle right
bindsym $mod+KP_Up exec $zone_helper cycle top
bindsym $mod+KP_8 exec $zone_helper cycle top
bindsym $mod+KP_Down exec $zone_helper cycle bottom
bindsym $mod+KP_2 exec $zone_helper cycle bottom
bindsym $mod+KP_5 exec $zone_helper cycle center
bindsym $mod+KP_Begin exec $zone_helper cycle center

# Sway has no generic fixed-size toggle. Window size hints are controlled by
# individual applications and cannot generally be switched off by the compositor.

